meta {
  name: Create student
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/students
  body: json
  auth: none
}

body:json {
  {
    "name": "Dean Thomas",
    "house_id": 1,
    "year": 5
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("studentId", res.body.id);
}
